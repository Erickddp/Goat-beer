# Copia este archivo como .env.local (no se sube al repo) y llena los valores.
# Sin DATABASE_URL el sitio funciona en modo preview con content/products.ts.

# Postgres (Supabase: pooler :6543 con ?sslmode=require · Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=

# Conexiones máximas por proceso (opcional, por defecto 5)
# DATABASE_POOL_MAX=5

# URL pública del sitio para Open Graph (opcional; en Vercel se detecta sola)
# NEXT_PUBLIC_SITE_URL=https://drunkgoat.mx
